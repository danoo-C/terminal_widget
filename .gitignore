# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# ---- Virtual environments ----
.venv/
venv/
ENV/
env/
.python-version

# ---- Testing / coverage / type checking ----
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.dmypy.json
.ruff_cache/

# ---- Frozen app output (PyInstaller / Nuitka) ----
*.spec
*.manifest
build-*/

# ---- Runtime / user data ----
# Local config written by the settings app; never commit a user's own settings.
config.local.*
*.log
logs/

# ---- Editors / IDEs / agent tooling ----
.idea/
.idea
.vscode/
.vscode
.claude/

# Claude Code's sandbox shadows these paths with empty placeholder files at
# session start, to stop anything reading or writing them. They are artifacts
# of the tool, not of the project, and they come back every session.
# .gitmodules is deliberately absent: it is a real git file and must stay
# trackable if this ever grows a submodule. It is excluded locally instead,
# in .git/info/exclude.
.bashrc
.bash_profile
.profile
.zshrc
.zprofile
.gitconfig
.mcp.json
.ripgreprc
*.swp
*.swo
*~

# ---- OS cruft ----
.DS_Store
Thumbs.db
desktop.ini
